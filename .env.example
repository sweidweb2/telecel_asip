NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database password (Project Settings → Database). Used by npm run db:migrate:remote.
SUPABASE_DB_PASSWORD=your-database-password

# Cloudflare Turnstile (contact form). Production TURNSTILE_HOSTNAMES must not include localhost.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET=your-turnstile-secret
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Temporary CMS admin perf tracker (writes to admin_perf_events). Off by default.
# ADMIN_PERF_TRACKING=true

# Cloudflare R2 — private backup object storage (manual + weekly cron).
# Prefer AWS_* names (S3-compatible). R2_* aliases also work.
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=telecel
# Base R2 S3 API URL (no bucket name in the path). Objects are stored under backups/...
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Optional key prefix if you need one beyond backups/:
# AWS_KEY_PREFIX=

# Or R2_* aliases:
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=telecel
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Hourly backup cron tick (/api/cron/backup). Required for scheduled runs.
# Cadence is controlled by site_settings.backup_time (Asia/Beirut).
BACKUP_CRON_SECRET=generate-a-long-random-secret
