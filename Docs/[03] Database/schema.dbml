// Source of truth: supabase/migrations/*.sql (applied in filename order).
// Reflects tables, enums, indexes, FKs, and RLS policy notes only.
// Functions / triggers / RPCs: see Docs/supabase-functions.md

Enum user_role {
  admin
  editor
  viewer
}

Enum inbox_status {
  unread
  reviewed
  archived
}

Table profiles {
  id uuid [pk, not null, note: 'FK → auth.users(id) ON DELETE CASCADE']
  email text [not null]
  full_name text
  role user_role [not null, default: 'viewer', note: 'Least-privilege column default; new rows from signup use handle_new_user (app_metadata.app_role, else viewer)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (role) [name: 'profiles_role_idx']
    (created_at, id) [name: 'profiles_created_at_id_idx', note: 'created_at DESC, id — list/pagination']
    email [type: gin, name: 'profiles_email_trgm_idx', note: 'pg_trgm gin_trgm_ops']
    full_name [type: gin, name: 'profiles_full_name_trgm_idx', note: 'pg_trgm gin_trgm_ops']
  }

  Note: '''
    RLS enabled.

    Grants:
    - authenticated: SELECT, UPDATE
    - service_role: SELECT
    - schema public USAGE: anon, authenticated, service_role

    Policies (authenticated):
    - Users can read own profile — SELECT USING (auth.uid() = id)
    - Users can update own profile — UPDATE USING/WITH CHECK (auth.uid() = id)
    - Admins can read all profiles — SELECT USING (is_admin())
    - Admins can update all profiles — UPDATE USING/WITH CHECK (is_admin())

    Role changes on own-profile UPDATE are blocked by trigger profiles_protect_role
    (only is_admin() may change role). Auth user create/delete via Admin API;
    profile insert via handle_new_user; delete via FK cascade.

    email and full_name are owned by auth.users: trigger on_auth_user_updated
    mirrors them into this table in the same transaction as the Auth write.
    Admin actions must not write those two columns directly — only role.
  '''
}

Table interest_registrations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  full_name text [not null, note: 'Founder name; CHECK char_length 2..100']
  founder_role text [note: 'CHECK 2..80 when set']
  email text [not null, note: 'CHECK char_length 3..254']
  phone text [not null, note: 'CHECK char_length 7..20']
  country text [not null, note: 'Founder country; CHECK 2..80']
  linkedin text [note: 'Optional for Register; http(s); CHECK <= 500']
  company_name text [not null, note: 'Startup name; CHECK 2..120']
  website text [note: 'Optional for Register; http(s); CHECK <= 500']
  company_country text [not null, note: 'CHECK 2..80']
  sector text [not null, note: 'Free text; CHECK 2..80']
  pitch text [note: 'Optional short note; CHECK 20..1000 when set']
  consent boolean [not null, note: 'CHECK (consent = true)']
  comms_opt_in boolean [not null, default: false]
  inbox_status inbox_status [not null, default: 'unread', note: 'Admin triage: unread → reviewed → archived']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (created_at) [name: 'interest_registrations_created_at_idx', note: 'created_at DESC — admin lists']
    (email) [name: 'interest_registrations_email_idx']
    (email, company_name) [name: 'interest_registrations_email_company_uidx', note: 'UNIQUE lower(email), lower(company_name)']
    (inbox_status, created_at) [name: 'interest_registrations_inbox_status_created_at_idx', note: 'created_at DESC — admin triage filter']
    full_name [type: gin, name: 'interest_registrations_full_name_trgm_idx', note: 'pg_trgm gin_trgm_ops — admin ILIKE search']
    email [type: gin, name: 'interest_registrations_email_trgm_idx', note: 'pg_trgm gin_trgm_ops — admin ILIKE search']
    company_name [type: gin, name: 'interest_registrations_company_name_trgm_idx', note: 'pg_trgm gin_trgm_ops — admin ILIKE search']
  }

  Note: '''
    RLS enabled. Leads / Register Interest intake (not Applications).

    Grants:
    - authenticated: SELECT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - no grants to anon (public cannot write via PostgREST)

    Policies (authenticated):
    - Admins can read/update/delete — is_admin()

    Public inserts only via Server Action + service role client.
    No automatic conversion to applications when Apply opens.
  '''
}

Table applications {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  full_name text [not null, note: 'CHECK 2..100']
  founder_role text [not null, note: 'CHECK 2..80']
  email text [not null, note: 'CHECK 3..254']
  phone text [not null, note: 'CHECK 7..20']
  country text [not null, note: 'CHECK 2..80']
  linkedin text [note: 'Optional for Apply; http(s); CHECK <= 500 when set']
  company_name text [not null, note: 'CHECK 2..120']
  website text [note: 'Optional for Apply; http(s); CHECK <= 500 when set']
  company_country text [not null, note: 'CHECK 2..80']
  sector text [not null, note: 'CHECK 2..80']
  problem_product text [not null, note: 'CHECK 40..4000']
  traction text [not null, note: 'CHECK 20..2000']
  programme_fit text [not null, note: 'CHECK 20..2000']
  consent boolean [not null, note: 'CHECK (consent = true)']
  comms_opt_in boolean [not null, default: false]
  inbox_status inbox_status [not null, default: 'unread', note: 'Admin triage: unread → reviewed → archived']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (created_at) [name: 'applications_created_at_idx', note: 'created_at DESC']
    (email) [name: 'applications_email_idx']
    (email, company_name) [name: 'applications_email_company_uidx', note: 'UNIQUE lower(email), lower(company_name)']
    (inbox_status, created_at) [name: 'applications_inbox_status_created_at_idx', note: 'created_at DESC — admin triage filter']
    full_name [type: gin, name: 'applications_full_name_trgm_idx', note: 'pg_trgm gin_trgm_ops — admin ILIKE search']
    email [type: gin, name: 'applications_email_trgm_idx', note: 'pg_trgm gin_trgm_ops — admin ILIKE search']
    company_name [type: gin, name: 'applications_company_name_trgm_idx', note: 'pg_trgm gin_trgm_ops — admin ILIKE search']
  }

  Note: '''
    RLS enabled. Official Apply intake pipeline (separate from Leads).

    Grants:
    - authenticated: SELECT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - anon: none

    Policies (authenticated):
    - Admins can read/update/delete — is_admin()

    Public inserts via Server Action + service role only.
    No automatic conversion from interest_registrations.
  '''
}

Enum contact_enquiry_type {
  founder
  partner
  media
  general
}

Table contact_messages {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  full_name text [not null, note: 'CHECK char_length between 2 and 100']
  email text [not null, note: 'CHECK char_length between 3 and 254']
  phone text [not null, note: 'CHECK char_length between 7 and 20']
  subject text [not null, note: 'CHECK char_length between 2 and 120']
  message text [not null, note: 'CHECK char_length between 20 and 2000']
  enquiry_type contact_enquiry_type [not null, default: 'general', note: 'Founder / partner / media routing; general is the catch-all']
  inbox_status inbox_status [not null, default: 'unread', note: 'Admin triage: unread → reviewed → archived']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (created_at) [name: 'contact_messages_created_at_idx', note: 'created_at DESC — admin lists']
    (email) [name: 'contact_messages_email_idx']
    (enquiry_type, created_at) [name: 'contact_messages_enquiry_type_idx', note: 'created_at DESC — admin inbox filter']
    (inbox_status, created_at) [name: 'contact_messages_inbox_status_created_at_idx', note: 'created_at DESC — admin triage filter']
    full_name [type: gin, name: 'contact_messages_full_name_trgm_idx', note: 'pg_trgm gin_trgm_ops — admin ILIKE search']
    email [type: gin, name: 'contact_messages_email_trgm_idx', note: 'pg_trgm gin_trgm_ops — admin ILIKE search']
    subject [type: gin, name: 'contact_messages_subject_trgm_idx', note: 'pg_trgm gin_trgm_ops — admin ILIKE search']
  }

  Note: '''
    RLS enabled.

    Grants:
    - authenticated: SELECT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - no grants to anon (public cannot write via PostgREST)

    Policies (authenticated):
    - Admins can read contact messages — SELECT USING (is_admin())
    - Admins can update contact messages — UPDATE USING/WITH CHECK (is_admin())
    - Admins can delete contact messages — DELETE USING (is_admin())

    CHECKs: contact_messages_*_len_chk on full_name, email, phone, subject, message
    (aligned with validations/contact-message.ts).

    enquiry_type (20260829000000) routes founder / partner / media / general
    submissions; inbox email routing is still app-side, not a separate table.

    No unique (email, subject) — follow-ups allowed; spam throttled by app rate limits.
    Public inserts only via Server Action + service role client.
    App validates with Zod before insert/update.
  '''
}

Table site_settings {
  id smallint [pk, not null, default: 1, note: 'CHECK id = 1 — singleton row (site_settings_singleton_chk)']
  open_applications boolean [not null, default: false, note: 'Drives navbar CTA, status banner, and Apply SEO (not URL exclusivity)']
  newsletter_signup_enabled boolean [not null, default: false, note: 'Insights newsletter module; off until privacy/routing confirmed']
  backup_time backup_schedule [not null, default: 'weekly_sun_03', note: 'Automated backup cadence in Asia/Beirut; now is UI-only']
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    RLS enabled.

    Grants:
    - anon, authenticated: SELECT
    - authenticated: UPDATE
    - service_role: SELECT, INSERT, UPDATE, DELETE

    Policies:
    - Anyone can read site settings — SELECT USING (true) for anon, authenticated
    - Admins can update site settings — UPDATE USING/WITH CHECK (is_admin())

    No INSERT/DELETE policy: the single row is seeded by the migration.
    Trigger site_settings_set_updated_at maintains updated_at.
  '''
}

Table newsletter_subscribers {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email text [not null, note: 'CHECK 3..254; UNIQUE lower(email)']
  consent boolean [not null, note: 'CHECK consent = true']
  source_page text [note: 'CHECK 1..120 when set']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (created_at) [name: 'newsletter_subscribers_created_at_idx', note: 'created_at DESC']
    email [unique, name: 'newsletter_subscribers_email_uidx', note: 'UNIQUE lower(email)']
  }

  Note: '''
    RLS enabled. Built inactive-by-default via site_settings.newsletter_signup_enabled.

    Grants:
    - authenticated: SELECT, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - anon: none

    Policies (authenticated):
    - Admins can read/delete — is_admin()

    Public inserts only via Server Action + service role when the toggle is on.
  '''
}

Enum blog_status {
  draft
  published
}

Table blogs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  slug text [not null, note: 'UNIQUE; URL-safe lowercase']
  title text [not null]
  summary text [not null]
  body_html text [not null, default: '', note: 'CHECK char_length <= 200000']
  categories text[] [not null, default: '{}', note: 'Free-text labels; first must be an ASIP stream for CMS writes. CHECK cardinality <= 8 and each label 1..40 chars via blog_categories_within_bounds()']
  thumbnail_url text [note: 'Storage bucket blogs']
  author_name text [not null]
  author_avatar_url text [note: 'Storage bucket auther']
  status blog_status [not null, default: 'draft']
  is_featured boolean [not null, default: false, note: 'At most one true — partial unique index']
  reading_time_minutes integer [not null, default: 1]
  published_at timestamptz
  startup_id uuid [note: 'Optional FK → startups; related founder']
  cohort_id uuid [note: 'Optional FK → cohorts']
  sources text[] [not null, default: '{}', note: 'CHECK via blog_sources_within_bounds(): cardinality <= 20; each trimmed item 1..500 chars']
  meta_title text [note: 'CMS SEO; CHECK 2..120 when set']
  meta_description text [note: 'CMS SEO; CHECK 2..300 when set']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (slug) [unique, name: 'blogs_slug_uidx']
    (is_featured) [unique, name: 'blogs_one_featured_uidx', note: 'WHERE is_featured = true']
    (status, published_at) [name: 'blogs_status_published_at_idx', note: 'published_at DESC']
    (created_at) [name: 'blogs_created_at_idx', note: 'created_at DESC']
    categories [type: gin, name: 'blogs_categories_gin_idx']
    (startup_id) [name: 'blogs_startup_id_idx', note: 'WHERE startup_id IS NOT NULL']
    (cohort_id) [name: 'blogs_cohort_id_idx', note: 'WHERE cohort_id IS NOT NULL']
  }

  Note: '''
    RLS enabled.

    Grants:
    - anon, authenticated: SELECT
    - authenticated: INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE

    Policies:
    - Anyone can read published blogs — SELECT USING (status = published)
    - Admins can read all blogs — SELECT USING (is_admin())
    - Admins can insert/update/delete — is_admin()

    Storage buckets (public read, admin write):
    - blogs — cover/thumbnail images
    - auther — author avatars

    Trigger: blogs_set_updated_at BEFORE UPDATE

    Writes go through create_blog_with_featured / update_blog_with_featured.
    Featured exclusivity is the partial unique index plus the unfeature step
    inside those RPCs — not a separate app-level clear-then-write.

    Article gaps (20260905190000): startup_id, cohort_id, sources,
    meta_title, meta_description.

    English-only content phase 1; EN/FR public pages show the same posts.
  '''
}

Enum startup_status {
  draft
  active
  inactive
}

Table startups {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  slug text [not null, note: 'UNIQUE; URL-safe lowercase']
  logo_url text [note: 'Storage bucket startups']
  description text [not null]
  status startup_status [not null, default: 'draft']
  founded_at date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (slug) [unique, name: 'startups_slug_uidx']
    (status, created_at) [name: 'startups_status_created_at_idx', note: 'created_at DESC']
    (created_at) [name: 'startups_created_at_idx', note: 'created_at DESC']
    name [type: gin, name: 'startups_name_trgm_idx', note: 'pg_trgm gin_trgm_ops']
    slug [type: gin, name: 'startups_slug_trgm_idx', note: 'pg_trgm gin_trgm_ops']
  }

  Note: '''
    RLS enabled.

    Grants:
    - authenticated: SELECT, INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - anon: none (revoked in 20260903090000; public reads go through startups_public)

    Policies:
    - Admins can read all startups — SELECT USING (is_admin())
    - Admins can insert/update/delete — is_admin()
    - "Anyone can read active startups" dropped in 20260903090000

    Storage bucket (public read, admin write):
    - startups — logo images

    Trigger: startups_set_updated_at BEFORE UPDATE
    Writes go through create_startup_with_details / update_startup_with_details
    (also persist startup_details portfolio columns).
    English-only content phase 1; EN/FR public pages show the same startups.
  '''
}

Table startup_details {
  startup_id uuid [pk, not null, note: 'FK → startups(id) ON DELETE CASCADE']
  website_url text
  industry text
  category text
  location text
  founding_year integer
  team text
  size text
  problem text
  solution text
  target_market text
  business_model text
  funding_goal numeric
  amount_raised numeric
  cohort text [note: 'Public portfolio label; CHECK length <= 40']
  country_code text [note: 'ISO 3166-1 alpha-2; CHECK ^[A-Z]{2}$']
  sector text [note: 'CHECK length <= 100']
  founder_names text[] [not null, default: '{}', note: 'CHECK cardinality <= 12']
  cover_image_url text [note: 'CHECK length <= 500']
  public_outcome text [note: 'CHECK length <= 2000']
  featured boolean [not null, default: false, note: 'Partial unique-style list index WHERE featured']
  image_focal_x numeric [not null, default: 50, note: 'CHECK 0–100']
  image_focal_y numeric [not null, default: 50, note: 'CHECK 0–100']

  indexes {
    (cohort) [name: 'startup_details_cohort_idx']
    (country_code) [name: 'startup_details_country_code_idx']
    (sector) [name: 'startup_details_sector_idx']
    (featured) [name: 'startup_details_featured_idx', note: 'WHERE featured']
    founder_names [type: gin, name: 'startup_details_founder_names_gin_idx']
  }

  Note: '''
    RLS enabled. 1:1 extension of startups.

    Grants:
    - authenticated: SELECT, INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - anon: none (revoked in 20260903090000; public reads go through startups_public)

    Policies:
    - Admins can read/insert/update/delete — is_admin()
    - "Anyone can read details of active startups" dropped in 20260903090000

    CHECKs: founding_year 1900–2100; funding_goal/amount_raised >= 0;
    amount_raised <= funding_goal when both set; length bounds on text fields;
    country_code ISO alpha-2; founder_names cardinality <= 12; focal 0–100.
    Internal-only fields (problem, solution, funding, size, founding_year)
    are not projected on startups_public.
  '''
}

// Flattened anonymous portfolio view (migration 20260903090000).
Table startups_public {
  id uuid
  name text
  slug text
  logo_url text
  description text
  founded_at date
  updated_at timestamptz
  website_url text
  industry text
  category text
  location text
  team text
  cohort text
  country_code text
  sector text
  founder_names text[]
  cover_image_url text
  public_outcome text
  featured boolean
  image_focal_x numeric
  image_focal_y numeric

  Note: '''
    VIEW, not a table: `create or replace view public.startups_public
    with (security_barrier = true) as select ... from public.startups
    left join public.startup_details ... where s.status = 'active'`.

    Definer rights on purpose — anon has no SELECT on public.startups /
    public.startup_details, so a security_invoker view would return zero rows.
    security_barrier = true reduces leaky-predicate risk on the status filter.

    Does not project status, created_at, founding_year, size, problem,
    solution, target_market, business_model, funding_goal, or amount_raised.

    Grants: SELECT to anon, authenticated.
    Read by data/startups.ts for the EN/FR public portfolio pages.
    Distinct filter facets also via RPC get_active_startup_filter_options().
  '''
}

Enum partner_type {
  corporate
  investors
  technology
  development
  mentors
  media
}

Table partners {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null, note: 'CHECK length 2–120']
  org text [note: 'CHECK length 2–160 when set; null for solo mentors']
  type partner_type [not null]
  contribution text [note: 'Role / contribution; CHECK length <= 2000']
  is_active boolean [not null, default: true, note: 'false = historical partner']
  logo_permission boolean [not null, default: false, note: 'Publication permission for the logo']
  logo_url text [note: 'Storage bucket partners']
  link text [note: 'CHECK http(s) URL, length <= 500']
  sort_order integer [not null, default: 1, note: 'CHECK 1–170']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active, type, sort_order, name) [name: 'partners_active_type_sort_idx']
    (created_at) [name: 'partners_created_at_idx', note: 'created_at DESC']
    name [type: gin, name: 'partners_name_trgm_idx', note: 'pg_trgm gin_trgm_ops']
    org [type: gin, name: 'partners_org_trgm_idx', note: 'pg_trgm gin_trgm_ops']
  }

  Note: '''
    RLS enabled.

    Grants:
    - authenticated: SELECT, INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - anon: none (revoked in 20260829030000; reads go through partners_public)

    Policies:
    - Authenticated can read partners — SELECT TO authenticated USING (true)
      (replaced "Anyone can read partners" in 20260829030000)
    - Admins can insert/update/delete — is_admin()

    logo_permission gates a column, not a row, so RLS cannot enforce it.
    The partners_public view applies that gate instead, and anon reads only
    the view. The public page renders an initials tile when logo_url is null.

    Storage bucket (public read, admin write):
    - partners — logo images (2 MB limit). Objects live under `{partner_id}/`
      and the whole prefix is deleted with the row.

    Trigger: partners_set_updated_at BEFORE UPDATE
    English-only content phase 1; EN/FR public pages show the same partners.
  '''
}

// View over partners for anonymous reads (migration 20260829030000).
Table partners_public {
  id uuid
  name text
  org text
  type partner_type
  link text
  is_active boolean
  sort_order integer
  logo_url text [note: 'CASE WHEN logo_permission THEN logo_url END — null without permission']

  Note: '''
    VIEW, not a table: `create view public.partners_public as select ... from public.partners`.

    Definer rights on purpose — anon has no SELECT on public.partners, so a
    security_invoker view would return zero rows. Every partner row was already
    world-readable under the old policy; the view only removes columns
    (logo_permission and contribution are not projected).

    Grants: SELECT to anon, authenticated.
    Read by data/partners.ts getPublicPartners for the EN/FR public pages.
  '''
}

Enum evidence_status {
  verified
  pending
  outdated
  disputed
  not_for_publication
}

Enum evidence_permission {
  public
  internal_only
  partner_approval_required
  legal_review_required
}

Table evidence_records {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  primary_source text [not null, note: 'CHECK length 2–2000']
  source_file_url text [note: 'Optional pasted http(s) URL; CHECK length <= 500; no Storage bucket in Phase 1']
  measurement_period_start date [not null]
  measurement_period_end date [not null, note: 'CHECK end >= start']
  owner_id uuid [not null, note: 'FK → profiles(id) ON DELETE RESTRICT']
  status evidence_status [not null, default: 'pending']
  last_verified_date date [not null]
  permission evidence_permission [not null]
  review_date date [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (created_at) [name: 'evidence_records_created_at_idx', note: 'created_at DESC']
    (status) [name: 'evidence_records_status_idx']
    (owner_id) [name: 'evidence_records_owner_id_idx']
    primary_source [type: gin, name: 'evidence_records_primary_source_trgm_idx', note: 'pg_trgm gin_trgm_ops']
  }

  Note: '''
    RLS enabled. Governance / Evidence Register (CMS Phase 1).

    Grants:
    - authenticated: SELECT, INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - anon: none

    Policies (authenticated):
    - Admins can read/insert/update/delete — is_admin()

    Trigger: evidence_records_set_updated_at BEFORE UPDATE
    Live metrics (Phase 2+) must only use status = verified.
  '''
}

Enum impact_lens {
  pipeline
  inclusion
  business_growth
  commercialisation
  jobs_capability
  sector_outcomes
}

Table impact_metrics {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  claim_label text [not null, note: 'CHECK length 2–200']
  value text [not null, note: 'CHECK length 1–80; supports "10,000+", "70%"']
  unit text [note: 'CHECK length 1–40 when set']
  period_start date [not null]
  period_end date [not null, note: 'CHECK end >= start']
  geography text [note: 'CHECK length 2–120 when set']
  impact_lens impact_lens
  display_locations text[] [note: 'e.g. homepage_module_02, impact_page']
  evidence_id uuid [not null, note: 'FK → evidence_records(id) ON DELETE RESTRICT']
  publish_status evidence_status [not null, default: 'pending', note: 'Only verified may render live (Phase 6)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (publish_status, impact_lens) [name: 'impact_metrics_publish_lens_idx']
    (created_at) [name: 'impact_metrics_created_at_idx', note: 'created_at DESC']
    (evidence_id) [name: 'impact_metrics_evidence_id_idx']
    claim_label [type: gin, name: 'impact_metrics_claim_label_trgm_idx', note: 'pg_trgm gin_trgm_ops']
  }

  Note: '''
    RLS enabled. Impact Metric content type (CMS Phase 2).

    Grants:
    - anon: SELECT
    - authenticated: SELECT, INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE

    Policies:
    - Anyone can read verified impact metrics — SELECT TO anon,
      authenticated USING (publish_status = 'verified')
    - Admins can read/insert/update/delete — is_admin()

    Trigger: impact_metrics_set_updated_at BEFORE UPDATE
    publish_status reuses evidence_status; only verified may render live.
  '''
}

Enum event_format {
  virtual
  in_person
  hybrid
}

Enum cms_publish_status {
  draft
  published
}

Enum quote_permission_status {
  granted
  pending
  denied
}

Table founder_stories {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  startup_id uuid [not null, note: 'FK → startups(id) ON DELETE CASCADE; UNIQUE — one story per startup']
  the_problem text [not null, note: 'CHECK char_length 2..4000']
  what_they_built text [not null, note: 'CHECK char_length 2..4000']
  the_asip_connection text [not null, note: 'CHECK char_length 2..4000']
  where_they_are_now text [not null, note: 'CHECK char_length 2..4000']
  founder_quote_text text [note: 'CHECK char_length <= 2000 when set']
  quote_attribution_name text [note: 'Required when quote present; CHECK 2..120']
  quote_attribution_title text [note: 'CHECK 2..160 when set']
  quote_date date
  quote_permission_status quote_permission_status [note: 'Required when quote present']
  publish_status cms_publish_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (startup_id) [unique, name: 'founder_stories_startup_id_uidx']
    (publish_status, updated_at) [name: 'founder_stories_publish_status_updated_at_idx', note: 'updated_at DESC']
  }

  Note: '''
    RLS enabled. Phase 4 CMS founder stories (owns cms_publish_status enum).

    Grants:
    - anon, authenticated: SELECT
    - authenticated: INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE

    Policies:
    - Anyone can read published founder stories — SELECT USING (publish_status = published)
    - Admins can read all founder stories — SELECT USING (is_admin())
    - Admins can insert/update/delete — is_admin()

    CHECK founder_stories_quote_block_chk: non-empty founder_quote_text
    requires attribution name + quote_permission_status.

    CHECK founder_stories_published_quote_granted_chk: when publish_status =
    published and quote text is non-empty, quote_permission_status must be
    granted (drafts may keep pending/denied). Also enforced in Zod.

    Additive to startups / startup_details — does not replace problem/solution.
    Evidence M2M (founder_story_evidence) deferred on purpose for Phase 4
    (evidence_records exists; junction not wired in admin yet).

    Trigger: founder_stories_set_updated_at BEFORE UPDATE
    English-only content phase 1; EN/FR public pages show the same stories.
  '''
}

Table events {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null, note: 'CHECK length 2–200']
  event_date date [not null, note: 'Not named date — reserved-ish']
  location text [note: 'CHECK length 1–200 when set']
  format event_format
  speakers text[] [not null, default: `'{}'`]
  assets text[] [not null, default: `'{}'`, note: 'http(s) URLs; no storage bucket yet']
  outcomes text [note: 'CHECK length <= 5000']
  publish_status cms_publish_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (publish_status, event_date) [name: 'events_publish_status_event_date_idx', note: 'event_date DESC']
    (event_date) [name: 'events_event_date_idx', note: 'event_date DESC']
    (created_at) [name: 'events_created_at_idx', note: 'created_at DESC']
    name [type: gin, name: 'events_name_trgm_idx', note: 'pg_trgm gin_trgm_ops']
  }

  Note: '''
    RLS enabled. Phase 5 CMS events table.

    Grants:
    - anon, authenticated: SELECT
    - authenticated: INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE

    Policies:
    - Anyone can read published events — publish_status = published
    - Admins can read all / insert / update / delete — is_admin()

    Trigger: events_set_updated_at BEFORE UPDATE
    Write RPCs: create_event_with_links / update_event_with_links
    (atomic event + event_startups). Assets are URL strings only (no bucket).
    Reuses cms_publish_status from Phase 4 (founder_stories).
  '''
}

Table event_startups {
  event_id uuid [not null, note: 'FK → events(id) ON DELETE CASCADE']
  startup_id uuid [not null, note: 'FK → startups(id) ON DELETE CASCADE']

  indexes {
    (event_id, startup_id) [pk]
    (startup_id) [name: 'event_startups_startup_id_idx']
    (event_id) [name: 'event_startups_event_id_idx']
  }

  Note: '''
    RLS enabled. M2M junction: events ↔ startups (founder participants).

    Grants:
    - anon, authenticated: SELECT
    - authenticated: INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE

    Policies:
    - Anyone can read rows whose event is published
    - Admins can read all / insert / update / delete — is_admin()

    cohort_events out of Phase 5 app scope (locked plan); add when wiring cohort admin.
  '''
}

Enum cohort_programme_status {
  closed
  open
  hold
}

Table cohorts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  year integer [not null, note: 'CHECK 1900–2100']
  public_label text [not null, note: 'CHECK length 2–160; UNIQUE with year']
  programme_dates_start date [note: 'VERIFY before publish (editorial)']
  programme_dates_end date [note: 'CHECK >= start when both set']
  programme_status cohort_programme_status [not null]
  summary text [note: 'CHECK length <= 5000']
  media_url text [note: 'Plain https URL; CHECK length <= 500; bucket later']
  publish_status cms_publish_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (year, public_label) [unique, name: 'cohorts_year_public_label_uidx']
    (publish_status, year) [name: 'cohorts_publish_status_year_idx', note: 'year DESC']
    (created_at) [name: 'cohorts_created_at_idx', note: 'created_at DESC']
  }

  Note: '''
    RLS enabled.

    Grants:
    - anon, authenticated: SELECT
    - authenticated: INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE

    Policies:
    - Anyone can read published cohorts — SELECT USING (publish_status = published)
    - Admins can read all / insert / update / delete — is_admin()

    Trigger: cohorts_set_updated_at BEFORE UPDATE
    Write RPCs: create_cohort_with_links, update_cohort_with_links
    Do not ALTER startups/partners for cohort FKs — M2M junctions only.
  '''
}

Table cohort_partners {
  cohort_id uuid [not null]
  partner_id uuid [not null]

  indexes {
    (cohort_id, partner_id) [pk]
    (partner_id) [name: 'cohort_partners_partner_id_idx']
  }

  Note: '''
    RLS enabled. Composite PK.

    Grants: same pattern as cohorts (anon/authenticated SELECT; authenticated write; service_role full).

    Policies:
    - Anyone can read partners of published cohorts — EXISTS parent publish_status = published
    - Admins can read all / insert / update / delete — is_admin()

    ON DELETE CASCADE from cohorts and partners.
  '''
}

Table cohort_startups {
  cohort_id uuid [not null]
  startup_id uuid [not null]

  indexes {
    (cohort_id, startup_id) [pk]
    (startup_id) [name: 'cohort_startups_startup_id_idx']
  }

  Note: '''
    RLS enabled. Composite PK. Planned founders → startups.id.

    Grants: same pattern as cohort_partners.

    Policies:
    - Anyone can read startups of published cohorts — EXISTS parent publish_status = published
    - Admins can read all / insert / update / delete — is_admin()

    ON DELETE CASCADE from cohorts and startups.
  '''
}

Table admin_perf_events {
  id uuid [pk, default: `gen_random_uuid()`]
  created_at timestamptz [not null, default: `now()`]
  request_id text [not null]
  parent_id uuid [null, note: 'Optional parent span']
  event_type text [not null, note: 'layout|page|action|data_read|option_load|mutation|upload']
  name text [not null]
  route text [null]
  duration_ms float [not null]
  db_ms float [null]
  cache_status text [not null, note: 'hit|miss|bypass|n_a']
  ok boolean [not null, default: true]
  error_message text [null]
  meta jsonb [not null, default: '{}']

  indexes {
    (created_at) [name: 'admin_perf_events_created_at_idx', note: 'DESC in SQL']
    (name, created_at) [name: 'admin_perf_events_name_created_at_idx']
    (cache_status, created_at) [name: 'admin_perf_events_cache_status_created_at_idx']
    (request_id) [name: 'admin_perf_events_request_id_idx']
    (event_type, created_at) [name: 'admin_perf_events_event_type_created_at_idx']
  }

  Note: '''
    Temporary CMS perf debug table. RLS enabled. Admin-only SELECT/INSERT/DELETE via is_admin().
    No anon grants. Teardown: drop table + remove lib/admin/perf instrumentation.
  '''
}

Ref: admin_perf_events.parent_id > admin_perf_events.id [delete: set null]

Enum backup_scope {
  full
  tables
  storage
  automated
}

Enum backup_status {
  pending
  processing
  completed
  failed
}

Enum backup_format {
  json
  csv
  sql
  zip
}

Enum backup_schedule {
  off
  daily_00
  daily_03
  daily_06
  daily_12
  daily_18
  weekly_sun_03
  weekly_mon_03
}

Table backups {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [null, note: 'Triggering admin; null for automated weekly jobs']
  scope backup_scope [not null]
  format backup_format [not null]
  target_tables text[] [null, note: 'Required when scope = tables']
  file_path text [null, note: 'Private R2 object key']
  file_size bigint [null]
  status backup_status [not null, default: 'pending']
  error_message text [null]
  schedule_window text [null, note: 'Idempotency/retry key for automated windows']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id) [name: 'backups_user_id_idx']
    (created_at) [name: 'backups_created_at_idx', note: 'DESC in SQL']
    (status) [name: 'backups_status_idx']
    (scope, created_at) [name: 'backups_scope_created_at_idx', note: 'DESC on created_at in SQL']
    (scope, schedule_window) [name: 'backups_scope_schedule_window_idx']
    (true) [name: 'backups_one_in_flight_uidx', note: 'Partial unique WHERE status IN (pending, processing) — at most one in-flight row']
  }

  Note: '''
    Admin backup audit log. File blobs live in private Cloudflare R2 (signed URLs only).
    RLS enabled. Admin-only SELECT/INSERT/UPDATE/DELETE via is_admin().
    service_role used by hourly cron export path. No anon grants.
    Overlap: partial unique index + app failStuckInFlightBackups (20m) before start/poll/cron.
  '''
}

Ref: backups.user_id > profiles.id [delete: set null]

// auth.users lives in Supabase auth schema (not managed in public migrations).
Table "auth.users" {
  id uuid [pk]

  Note: 'Managed by Supabase Auth. Referenced only; not defined in public migrations.'
}

Ref: profiles.id > "auth.users".id [delete: cascade]
